# Server Configuration
PORT=8080
HOST=0.0.0.0
ENVIRONMENT=development

# SQLite database directory (default: /nasnet-panel/database in production, ./data otherwise)
# DATABASE_DIR=

# Development only: use this router user ID instead of a generated one.
# Ignored by production builds. Put the value in the git-ignored .env.local.
# NASNET_DEV_USER_ID=

# Development only: keep JWTs valid across backend restarts. Empty means a random
# key per process. Ignored by production builds. Put the value in .env.local.
# NASNET_DEV_SIGNING_KEY=

# Development only: RouterOS password used to restore a session lost on restart,
# together with NASNET_DEV_SIGNING_KEY. Ignored by production builds.
# NASNET_DEV_ROUTER_PASSWORD=
