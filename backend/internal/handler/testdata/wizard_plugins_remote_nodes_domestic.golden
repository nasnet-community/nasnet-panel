/ip firewall address-list
add address=192.168.50.17 list="VPN-LAN" comment="plugin:remote-nodes"
/ip firewall mangle
add action=mark-routing chain=prerouting comment="plugin:remote-nodes" dst-address-list=!LOCAL-IP new-routing-mark=to-Foreign passthrough=no src-address=192.168.50.16
add action=mark-routing chain=prerouting comment="plugin:remote-nodes" dst-address-list=!LOCAL-IP new-routing-mark=to-Domestic passthrough=no src-address=192.168.50.18
