/system script
:foreach i in=[/system/script find] do={
  :local scriptName [/system/script get $i name]
  :if ([:typeof [:find $scriptName "wizard"]] = "nil") do={
    /system/script remove $i
  }
}

/system script environment
:foreach i in=[/system/script/environment find] do={
