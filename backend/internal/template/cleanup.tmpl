}

/ip firewall mangle
:foreach i in=[/ip/firewall/mangle find] do={
  /ip/firewall/mangle remove $i
}

/ipv6 firewall filter
:foreach i in=[/ipv6/firewall/filter find] do={
  /ipv6/firewall/filter remove $i
}

/ip firewall address-list
:foreach i in=[/ip/firewall/address-list find dynamic=no] do={
  /ip/firewall/address-list remove $i
}

/ip dns forwarder
:foreach i in=[/ip/dns/forwarder find] do={
  /ip/dns/forwarder remove $i
}

/ip dns static
:foreach i in=[/ip/dns/static find] do={
