# Cleanup script - Reset network interfaces to default names and clear comments

/interface wifi
:foreach i in=[/interface/wifi find] do={
  :local defaultName [/interface/wifi get $i default-name]
  :if ([:len $defaultName] = 0) do={
    :continue
  }
  :local currentName [/interface/wifi get $i name]
  :if ($currentName != $defaultName) do={
    /interface/wifi set $i name=$defaultName
  }
  /interface/wifi set $i comment=""
}

/interface ethernet
:foreach i in=[/interface/ethernet find] do={
  :local defaultName [/interface/ethernet get $i default-name]
  :if ([:len $defaultName] = 0) do={
    :continue
  }
  :local currentName [/interface/ethernet get $i name]
  :if ($currentName != $defaultName) do={
    /interface/ethernet set $i name=$defaultName
  }
  /interface/ethernet set $i comment=""
}

/interface vlan
:foreach i in=[/interface/vlan find] do={
  /interface/vlan set $i comment=""
}

/interface bridge
:foreach i in=[/interface/bridge find] do={
  :local bridgeName [/interface/bridge get $i name]
  :if ($bridgeName = "LANBridgeSplit" || $bridgeName = "containers") do={
    :continue
  }
  /interface/bridge/port remove [find bridge=$bridgeName]
  /interface/bridge remove $i
}

/interface bonding
:foreach i in=[/interface/bonding find] do={
  /interface/bonding set $i comment=""
}

/interface macvlan
:foreach i in=[/interface/macvlan find] do={
  /interface/macvlan remove $i
}

/interface list
:foreach i in=[/interface/list find dynamic=no] do={
  :local listName [/interface/list get $i name]
  :local isBuiltin [/interface/list get $i builtin]
  :if ($isBuiltin = true) do={
    :continue
  }
  /interface/list/member remove [find list=$listName]
  /interface/list remove $i
}

/ip pool
:foreach i in=[/ip/pool find] do={
  :local poolName [/ip/pool get $i name]
  :if ($poolName = "DHCP-pool-Split") do={
    :continue
  }
  /ip/pool remove $i
}

/ip dhcp-server
:foreach i in=[/ip/dhcp-server find] do={
  :local poolName [/ip/dhcp-server get $i address-pool]
  :if ($poolName = "DHCP-pool-Split") do={
    :continue
  }
  /ip/dhcp-server remove $i
}

/ip dhcp-server network
:foreach i in=[/ip/dhcp-server/network find] do={
  :local comment [/ip/dhcp-server/network get $i comment]
  :if ($comment = "Split") do={
    :continue
  }
  /ip/dhcp-server/network remove $i
}

/ip dhcp-client
:foreach i in=[/ip/dhcp-client find] do={
  /ip/dhcp-client remove $i
}

/ip firewall filter
:foreach i in=[/ip/firewall/filter find] do={
  /ip/firewall/filter remove $i
}

/ip firewall nat
:foreach i in=[/ip/firewall/nat find] do={
