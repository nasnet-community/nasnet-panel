}

/ip nat-pmp interfaces
:foreach i in=[/ip/nat-pmp/interfaces find] do={
  :local interface [/ip/nat-pmp/interfaces get $i interface]
  :if ($interface = "LANBridgeSplit") do={
    :continue
  }
  /ip/nat-pmp/interfaces remove $i
}

/ip route
:foreach i in=[/ip/route find] do={
  :local isDynamic [/ip/route get $i dynamic]
  :if ($isDynamic = true) do={
    :continue
  }
  /ip/route remove $i
}

/ip address
:foreach i in=[/ip/address find] do={
  :local comment [/ip/address get $i comment]
  :local interface [/ip/address get $i interface]
  :if ($comment = "Split" || $interface = "Split" || $interface = "containers") do={
    :continue
  }
  /ip/address remove $i
}

/routing table
:foreach i in=[/routing/table find] do={
  :local isDynamic [/routing/table get $i dynamic]
