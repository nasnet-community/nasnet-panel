:foreach w in=[/interface wifi find] do={
:local defaultName [/interface/wifi get $w default-name]
  :if ([:len $defaultName] = 0) do={
  :continue
  }
/interface wifi set $w name=$defaultName comment=""
/interface wifi unset $w steering
}

:foreach iface in=[/interface ethernet find] do={
/interface ethernet set $iface name=[get $iface default-name] comment=""
}

/interface vlan remove [find]


/interface/bridge/port remove [find bridge!="containers"]
/interface/bridge remove [find name!="containers"]

/interface bonding remove [find]
/interface macvlan remove [find]

/interface list member remove [find dynamic=no]
/interface list remove [find dynamic=no builtin=no]

:foreach i in=[/ip/pool find] do={
  :local poolName [/ip/pool get $i name]
  :if ($poolName = "DHCP-pool-Split") do={
    :continue
  }
  /ip/pool remove $i
}

