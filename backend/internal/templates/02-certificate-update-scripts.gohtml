add address="192.168.31.0/24" dns-server="192.168.31.1" gateway="192.168.31.1" comment="Foreign-Foreign Link"
add address="192.168.21.0/24" dns-server="192.168.21.1" gateway="192.168.21.1" comment="Domestic-Domestic Link"
add address="192.168.41.0/24" dns-server="192.168.41.1" gateway="192.168.41.1" comment="VPN-L2TP-Client"
/ip dns
set allow-remote-requests=yes  max-concurrent-queries=500 max-concurrent-tcp-sessions=50 cache-size=20480KiB cache-max-ttl=7d
set servers=4.2.2.2,217.218.127.127,4.2.2.1
set mdns-repeat-ifaces="LANBridgeSplit,LANBridgeDomestic,LANBridgeForeign,LANBridgeVPN,LANBridgeForeign-Foreign Link,LANBridgeDomestic-Domestic Link,LANBridgeVPN-L2TP-Client"
set use-doh-server="https://8.8.8.8/dns-query" verify-doh-cert=no doh-max-concurrent-queries=500 doh-max-server-connections=50
/ip dns forwarders
add name=VPN dns-servers=4.2.2.2 verify-doh-cert=no
add name=Domestic dns-servers=217.218.127.127 verify-doh-cert=no
add name=Foreign dns-servers=4.2.2.1 verify-doh-cert=no
add name=General dns-servers=4.2.2.2,217.218.127.127,4.2.2.1 verify-doh-cert=no
/ip dns static
