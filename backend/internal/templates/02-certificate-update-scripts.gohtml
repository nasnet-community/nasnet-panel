distance=1 target-scope="11" comment="Route-to-VPN-L2TP-Client"
add dst-address="4.2.2.2" gateway="l2tp-client-L2TP-Client" \
routing-table="main" scope="10" comment="Route-to-VPN-L2TP-Client"
