/ip service
set api address=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 port=8728
set api-ssl address=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 port=8729
set ftp address=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 port=21
set ssh address=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 port=22
set telnet address=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 port=23
set winbox address=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 port=8291
set www address=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 port=80
set www-ssl address=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8 port=443
/ip upnp
set enabled=yes
/ipv6 firewall filter
add chain=input action=drop
add chain=forward action=drop
/system clock
set date=Jun/11/2026
set time-zone-autodetect=no time-zone-name=Asia/Tehran
/system identity
set name="{{.wifi_ssid}}"
/system logging action
add disk-file-count=10 disk-file-name=ConnectLog disk-lines-per-file=100 disk-stop-on-full=yes name=DiskC target=disk
/system logging
set 0 topics=info,!netwatch
add action=DiskC disabled=no prefix="" regex="" topics=critical,error,info,warning
/system ntp client
set enabled=yes
/system ntp server
set broadcast=yes enabled=yes manycast=yes multicast=yes
/system ntp client servers
add address="pool.ntp.org"
add address="time.cloudflare.com"
add address="time.google.com"
/system package update
set channel=stable
/system routerboard settings
set auto-upgrade=yes
/system scheduler
add interval=1m name=VPNE-Routing-Manager on-event="/system script\r\nrun VPNE-Routing-Manager" policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon start-time=startup
add interval=00:00:00 name=VPNE-Routing-Manager-Startup on-event=":delay 10s\r\n/system script\r\nrun VPNE-Routing-Manager\r\n:delay 10s\r\n/system script\r\nrun VPNE-Routing-Manager\r\n:delay 10s\r\n/system script\r\nrun VPNE-Routing-Manager\r\n:delay 10s\r\n/system script\r\nrun VPNE-Routing-Manager\r\n:delay 10s\r\n/system script\r\nrun VPNE-Routing-Manager" policy=ftp,reboot,read,write,policy,test,password,sniff,sensitive,romon start-time=startup
