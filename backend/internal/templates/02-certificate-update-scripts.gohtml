/ip firewall address-list
add comment="LOCAL-IP" address="192.168.0.0/16" list="LOCAL-IP"
add comment="LOCAL-IP" address="172.16.0.0/12" list="LOCAL-IP"
add comment="LOCAL-IP" address="10.0.0.0/8" list="LOCAL-IP"
