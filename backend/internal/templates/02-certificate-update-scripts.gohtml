routing-table="main" scope="10" comment="Route-to-Domestic-Domestic Link"
add dst-address="4.2.2.1" gateway="100.64.0.1%MacVLAN-ether1-Foreign Link" \
routing-table="main" scope="10" comment="Route-to-Foreign-Foreign Link"
add check-gateway=ping dst-address="0.0.0.0/0" gateway="4.2.2.2" routing-table="main" \
distance="1" target-scope="11" comment="CheckIP-Route-to-VPN-L2TP-Client"
add check-gateway=ping dst-address="0.0.0.0/0" gateway="217.218.127.127" routing-table="main" \
distance="5" target-scope="11" comment="CheckIP-Route-to-Domestic-Domestic Link"
add check-gateway=ping dst-address="0.0.0.0/0" gateway="4.2.2.1" routing-table="main" \
distance="10" target-scope="11" comment="CheckIP-Route-to-Foreign-Foreign Link"
add comment=Blackhole blackhole disabled=no distance=99 dst-address=0.0.0.0/0 gateway="" routing-table="to-Split"
add comment=Blackhole blackhole disabled=no distance=99 dst-address=0.0.0.0/0 gateway="" routing-table="to-Domestic"
add comment=Blackhole blackhole disabled=no distance=99 dst-address=0.0.0.0/0 gateway="" routing-table="to-Foreign"
add comment=Blackhole blackhole disabled=no distance=99 dst-address=0.0.0.0/0 gateway="" routing-table="to-VPN"
add comment="Route-to-Foreign-Foreign Link 1" distance=1 dst-address=192.168.100.0/24 gateway=100.64.0.1 routing-table="to-VPN"
add comment=Blackhole blackhole disabled=no distance=99 dst-address=0.0.0.0/0 gateway="" routing-table="to-Foreign-Foreign Link"
add comment=Blackhole blackhole disabled=no distance=99 dst-address=0.0.0.0/0 gateway="" routing-table="to-Domestic-Domestic Link"
