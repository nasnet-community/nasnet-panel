/ip cloud
set ddns-enabled=yes ddns-update-interval=1m
/ip dhcp-client
add add-default-route=no comment="Foreign Link to Foreign" interface="MacVLAN-ether1-Foreign Link" script=":if (\$bound=1) do={\r\
\n:local gw (\$\"gateway-address\" . \"%\" . \$interface)\r\
\n:local routeCount [/ip route print count-only where comment=\"Route-to-Foreign-Foreign Link\"]\r\
\n:if (\$routeCount > 0) do={\r\
\n    /ip route set [ find comment=\"Route-to-Foreign-Foreign Link\" gateway!=\$gw ] gateway=\$gw\r\
\n}\r\
\n}" use-peer-dns=no use-peer-ntp=no
add add-default-route=no comment="Domestic Link to Domestic" interface="MacVLAN-ether2-Domestic Link" script=":if (\$bound=1) do={\r\
\n:local gw (\$\"gateway-address\" . \"%\" . \$interface)\r\
\n:local routeCount [/ip route print count-only where comment=\"Route-to-Domestic-Domestic Link\"]\r\
\n:if (\$routeCount > 0) do={\r\
\n    /ip route set [ find comment=\"Route-to-Domestic-Domestic Link\" gateway!=\$gw ] gateway=\$gw\r\
\n}\r\
\n}" use-peer-dns=no use-peer-ntp=no
/ip dhcp-server network
add address="192.168.10.0/24" dns-server="192.168.10.1" gateway="192.168.10.1" comment="Split"
add address="192.168.20.0/24" dns-server="192.168.20.1" gateway="192.168.20.1" comment="Domestic"
add address="192.168.30.0/24" dns-server="192.168.30.1" gateway="192.168.30.1" comment="Foreign"
